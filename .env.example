# Frontend can set VITE_API_URL to a deployed API URL. Local default is http://localhost:8000.
VITE_API_URL=http://localhost:8000
TRANSITGAP_RADIUS_M=1500
# TRANSITGAP_DATA_DIR=/path/to/cache
# Optional, finite nonnegative multipliers used by prefer_documented_paths.
# Defaults are defined in backend/app/accessibility.py.
# TRANSITGAP_UNCERTAINTY_PENALTY_SURFACE=0.20
# TRANSITGAP_UNCERTAINTY_PENALTY_SMOOTHNESS=0.15
# TRANSITGAP_UNCERTAINTY_PENALTY_INCLINE=0.20
# TRANSITGAP_UNCERTAINTY_PENALTY_WHEELCHAIR=0.35
# TRANSITGAP_UNCERTAINTY_PENALTY_WIDTH=0.10
# TRANSITGAP_UNCERTAINTY_PENALTY_SIDEWALK=0.10
# TRANSITGAP_UNCERTAINTY_PENALTY_CROSSING=0.15
# TRANSITGAP_UNCERTAINTY_PENALTY_KERB=0.15
# TRANSITGAP_UNCERTAINTY_PENALTY_TACTILE_PAVING=0.10
